# ─── DATABASE ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe_StrongPassword_123!
POSTGRES_DB=fab_construction_ims

# ─── BACKEND ─────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_HEX_STRING

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Your VPS IP or domain, no trailing slash
# Examples:
#   ALLOWED_ORIGINS=http://123.45.67.89
#   ALLOWED_ORIGINS=https://ims.fabconstruction.com
ALLOWED_ORIGINS=http://localhost:3000

# ─── MEDIA ───────────────────────────────────────────────────────────────────
MEDIA_DIR=/app/media
MAX_FILE_SIZE_MB=10
