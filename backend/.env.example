# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/fab_construction_ims

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Invoice reading (Tesseract OCR). Set TESSERACT_CMD only if tesseract
# isn't on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=sqi+eng
MAX_INVOICE_FILE_MB=15

# App
APP_ENV=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin seed account
ADMIN_EMAIL=admin@fabconstruction.com
ADMIN_PASSWORD=Admin@123
ADMIN_FULL_NAME=System Administrator
